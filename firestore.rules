rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 캐릭터: 누구나 보기, 익명 인증된 참여자는 등록, 본인이 올린 것만 삭제
    match /characters/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'img', 'uid', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.img is string
        && request.resource.data.img.size() < 400000
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // 고화질 사진: characters 와 같은 id. 문서 1MB 한도 안쪽
    match /images/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['data', 'uid'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && (resource == null || resource.data.uid == request.auth.uid);
    }

    // 월드컵 결과: 누구나 보기, 추가만 가능(수정·삭제 불가)
    match /results/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.top10 is list
        && request.resource.data.top10.size() <= 10
        && request.resource.data.champions is list
        && request.resource.data.champions.size() <= 2;
    }

    // 전체 순위 초기화: 관리자 비밀번호 확인용 기록. 아무도 읽을 수 없음
    match /adminlog/{id} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['pw', 'at', 'uid'])
        && request.resource.data.pw == '여기에_관리자_비밀번호'  // 콘솔에 게시할 때만 실제 비밀번호로 바꿈 (공개 저장소라 여기엔 안 적음)
        && request.resource.data.at == request.time
        && request.resource.data.uid == request.auth.uid;
    }

    // 순위 초기화 시각. 비밀번호 기록(adminlog)을 같은 batch 안에서 새로 만들 때만 바꿀 수 있음
    match /meta/ranking {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['resetAt', 'logId'])
        && request.resource.data.resetAt == request.time
        && request.resource.data.logId is string
        && !exists(/databases/$(database)/documents/adminlog/$(request.resource.data.logId))
        && existsAfter(/databases/$(database)/documents/adminlog/$(request.resource.data.logId));
    }
  }
}
